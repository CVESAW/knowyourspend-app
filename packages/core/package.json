{
  "name": "@kys/core",
  "version": "0.1.0",
  "description": "Platform-neutral KnowYourSpend logic shared by the web and Expo apps: spend aggregation, receipt text parsing, image prep for OCR, formatting and types. Runs on the device.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kys/ownership": "workspace:*",
    "@kys/statement": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
