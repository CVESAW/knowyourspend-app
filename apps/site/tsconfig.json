{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@kys/core/*": ["../../packages/core/src/*"],
      "@kys/ownership": ["../../packages/ownership/src/index.ts"],
      "@kys/statement": ["../../packages/statement/src/index.ts"]
    }
  },
  "include": ["src/*.ts"]
}
